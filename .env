# Connect to Postgres started by `process-compose`.
export PGDATA=$GORGON_ROOT/.direnv/pg/data
export PGHOST=$GORGON_ROOT/.direnv/pg
export PGDATABASE=gorgon
export GORGOND_DATABASE_URL=postgres:///$PGDATABASE?host=$PGHOST

# Store event log files in ./data/events/.
export GORGON_EVENT_STORE_URL=file://$GORGON_ROOT/data/events/
export GORGON_EVENT_BASE_URL=file://$GORGON_ROOT/data/events/
